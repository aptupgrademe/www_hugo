.vscode
.git
.ansible
.claude

# Ansible Vault password file – never commit this
.vault_pass

# Vault credential files – never commit real passwords.
# Copy vault.yml.example → vault.yml and fill in your values.
**/vault.yml

# Host-specific variables – contain real IPs, hostnames and domains.
# Copy vars.yml.example → vars.yml and fill in your values.
inventory/host_vars/*/vars.yml

# Main inventory – contains real server IPs.
# Copy hosts.yml.example → hosts.yml and fill in your values.
inventory/hosts.yml

# Internal fix/audit notes – never published to a remote.
docs/*-fixes-*.md
docs/*-audit*.md

# Blog post drafts – written here for convenience, published on the blog,
# not part of the repo. Untracked alone is not enough: a `git add -A` would
# sweep them into a commit and onto the public remote.
blog-draft-*

# Internal notes: kept out of main (and thus GitHub). Backed up to the
# internal GitLab only, via the "internal" branch (git add -f on that branch).
notes/

# Filled-in backup scripts (real hostnames) stay local.
scripts/blog-backup/*_backup.sh

# Python bytecode
__pycache__/
*.pyc

# Internal explainer PDFs for non-IT readers (German only) - never published.
docs/intern/

# Inventory of the test VM (address in its host_vars)
inventory/test-only.yml
