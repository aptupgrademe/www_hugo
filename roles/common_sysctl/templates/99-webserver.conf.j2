# Managed by Ansible – do not edit manually
# =============================================================================
# Kernel tuning for web server performance
# Applied via sysctl.d – persistent across reboots.
# =============================================================================

# --- TCP Congestion Control: BBR ---
# BBR (Bottleneck Bandwidth and RTT) achieves higher throughput and lower
# latency than CUBIC, especially on connections with packet loss.
# Requires fq (Fair Queueing) as the packet scheduler.
net.core.default_qdisc          = fq
net.ipv4.tcp_congestion_control = bbr

# --- TCP Fast Open ---
# Allows data in the SYN packet on reconnects (requires prior connection).
# 3 = enable for both incoming and outgoing connections.
net.ipv4.tcp_fastopen = 3

# --- Disable TCP slow-start after idle ---
# By default Linux reduces the TCP window after an idle period.
# For a web server with sporadic visitors this causes unnecessary slowdown.
net.ipv4.tcp_slow_start_after_idle = 0

# --- Connection cleanup ---
net.ipv4.tcp_fin_timeout     = 15
net.ipv4.tcp_keepalive_time  = 60
net.ipv4.tcp_keepalive_intvl = 10
net.ipv4.tcp_keepalive_probes = 5

# --- Backlog / receive queue ---
net.core.netdev_max_backlog      = 5000
net.core.somaxconn               = 4096
# Match SYN backlog to somaxconn – avoids SYN drop under burst traffic.
net.ipv4.tcp_max_syn_backlog     = 4096

# --- UDP socket buffer ceiling for QUIC (HTTP/3) ---
# QUIC runs in user space over UDP: every packet waits in the socket's
# receive buffer until nginx reads it. With the kernel's 208 KB maximum a
# 20 MB upload over HTTP/3 overflowed it - 284 dropped packets (Udp
# RcvbufErrors) and 7.8 MB/s instead of 11.9 MB/s over HTTP/2 (2026-11-03).
# This only raises the ceiling; the quic listeners ask for 4 MB themselves
# (rcvbuf/sndbuf on the listen line, blog_web), every other socket keeps
# the 208 KB default. 7.5 MB is the value QUIC implementations recommend.
net.core.rmem_max = 7500000
net.core.wmem_max = 7500000

# --- Write-back of dirty pages ---
# Defaults are 10 % / 30 % of RAM: on a 24 GB host up to ~7 GB of unwritten
# data can pile up and then be flushed in one burst (backup pulls, site
# deploys), stalling other I/O. Starting background write-back at
# 5 % and throttling writers at 10 % keeps the flushes smaller and steadier.
vm.dirty_background_ratio = 5
vm.dirty_ratio            = 10
