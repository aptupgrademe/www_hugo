# Managed by Ansible – do not edit manually
# Detects brute-force POST attempts against Grafana's /grafana/login.
# Log source: /var/log/nginx/access.log, format:
#   <client_ip> - - [nginx_time] "POST /grafana/login HTTP/2.0" 401 ...
#
# This matches ONLY the 401 status:
# Grafana returns a clean 401 on a failed login and 200/302 on success, so we
# can count failures precisely instead of every POST. That means a legitimate
# admin logging in successfully never contributes to the ban counter.

# fail2ban cuts the timestamp out of the line before matching, so the pattern
# must not expect the brackets to contain anything.
[Definition]
failregex = ^<HOST> - \S+ [^"]*"POST /grafana/login\s+HTTP/\S+"\s+401\b

ignoreregex =
