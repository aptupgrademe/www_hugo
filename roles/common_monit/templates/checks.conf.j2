# Managed by Ansible (common_monit) - do not edit manually.
# Per-check definitions, included by /etc/monitrc. All state changes are
# e-mailed automatically via the global `set alert` in monitrc.

# --- Host resources ---
check system {{ monit_hostname }}
    if loadavg (5min) > {{ monit_loadavg_max }} for 3 cycles then alert
    if memory usage > {{ monit_mem_pct_max }}% for 3 cycles then alert

check filesystem rootfs with path /
    if space usage > {{ monit_disk_pct_max }}% then alert
    if inode usage > {{ monit_disk_pct_max }}% then alert

# --- fail2ban: auto-restart, and give up + alert if it will not stay up ---
# (This is the case that went unnoticed for two days: a config error made
#  fail2ban exit on start. Monit restarts it; if it keeps dying it stops
#  trying and sends a timeout alert instead of silently flapping.)
check process fail2ban with pidfile /run/fail2ban/fail2ban.pid
    start program = "/usr/bin/systemctl start fail2ban" with timeout 90 seconds
    stop  program = "/usr/bin/systemctl stop fail2ban"
    if does not exist then restart
    if 3 restarts within 5 cycles then timeout

# --- every fail2ban ban really in the firewall (since 2026-10-21) ---
# fail2ban's own view and the nftables sets can drift apart (shared-set
# unbans until 2026-10-21, or a reload that emptied the sets). Two cycles, so
# a ban being applied at that very moment is not an alert.
check program f2b_sets with path "/usr/local/sbin/monit-check-f2b-sets.sh"
    if status != 0 for 2 cycles then alert

# --- Mail relay: a message msmtp could not deliver (since 2026-10-26) ---
# Cron, rkhunter, AIDE and logwatch mail through msmtp; a rejected envelope
# sender went unnoticed for weeks because nothing reads msmtp.log. Monit
# reads only the lines added since the last cycle and mails through its own
# SMTP connection, so the alert gets out even when msmtp's does not.
# (POSIX regex, no lookahead: every sysexits code except EX_OK.)
check file msmtp_log with path /var/log/msmtp.log
    ignore content != "exitcode="
    if content = "exitcode=EX_(USAGE|DATAERR|NOINPUT|NOUSER|NOHOST|UNAVAILABLE|SOFTWARE|OSERR|OSFILE|CANTCREAT|IOERR|TEMPFAIL|PROTOCOL|NOPERM|CONFIG)" then alert

# --- Other critical services: alert on state change (no auto-restart) ---
{% for svc in monit_present_services %}
check program svc_{{ svc | replace('-', '_') }} with path "/usr/local/sbin/monit-check-service.sh {{ svc }}"
    if status != 0 then alert
{% endfor %}

# --- Firewall actually enforcing (input chain default-drop) ---
check program firewall with path "/usr/local/sbin/monit-check-firewall.sh"
    if status != 0 then alert

# --- fail2ban jails actually watching a file, not just "running" ---
check program f2b_jails with path "/usr/local/sbin/monit-check-f2b-jails.sh"
    if status != 0 then alert

# --- TLS certificates: warn long before they expire ---
# Checked about once an hour - certificate expiry moves in days, there is
# nothing to gain from checking every cycle, and each check opens a TLS
# connection per hostname.
# Cron form, because Monit (6.0 here) warns that "every N cycles" is deprecated.
# The window is two minutes wide (0-1) on purpose: with a {{ monit_check_interval }}s cycle a
# single-minute spec can fall between two cycles and be skipped. An
# occasional double run or skipped hour is harmless for this check.
check program certs with path "/usr/local/sbin/monit-check-certs.sh {{ monit_cert_min_days }}"
    every "0-1 * * * *"
    if status != 0 then alert

# --- Backup freshness ---
# The backup machine pulls the blog (scripts/blog-backup) and touches this file
# on success. A missing file alerts too. Two-minute window for the same reason
# as the certs check above.
check file blog_backup with path /var/lib/blog-backup/last-success
    every "17-18 * * * *"
    if timestamp > {{ monit_backup_max_days }} days then alert

# --- The published site answers, not just "nginx runs" ---
check host blog_site with address 127.0.0.1
    if failed port 443 protocol https request / with http headers [Host: {{ blog_web_tls_names[0] }}] status = 200 then alert
