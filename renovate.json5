// Renovate: proposes version bumps as pull requests - the pins in
// inventory/group_vars/all/versions.yml, the collections (requirements.yml),
// the GitHub Action and the pre-commit hooks.
// Nothing is merged automatically: every PR is reviewed, then rolled out with
// the playbook (--check --diff first, see docs/blog-operations.html).
// Needs the Renovate GitHub app installed for this repository.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  timezone: "Europe/Berlin",
  schedule: ["before 6am on monday"],
  prConcurrentLimit: 5,
  dependencyDashboard: true,
  labels: ["dependencies"],
  "pre-commit": { enabled: true },

  customManagers: [
    // Binaries pinned without the release tag's "v": node_exporter 1.12.1 <- tag v1.12.1
    {
      customType: "regex",
      description: "Prometheus binaries",
      managerFilePatterns: ["/^inventory/group_vars/all/versions\\.yml$/"],
      matchStrings: ['\\n(?<depName>node_exporter|prometheus)_version:\\s+"(?<currentValue>[^"]+)"'],
      packageNameTemplate: "prometheus/{{{depName}}}",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "nginx exporter",
      managerFilePatterns: ["/^inventory/group_vars/all/versions\\.yml$/"],
      matchStrings: ['\\nnginx_exporter_version:\\s+"(?<currentValue>[^"]+)"'],
      depNameTemplate: "nginx/nginx-prometheus-exporter",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "Hugo",
      managerFilePatterns: ["/^inventory/group_vars/all/versions\\.yml$/"],
      matchStrings: ['\\nhugo_version:\\s+"(?<currentValue>[^"]+)"'],
      depNameTemplate: "gohugoio/hugo",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "Pagefind",
      managerFilePatterns: ["/^inventory/group_vars/all/versions\\.yml$/"],
      matchStrings: ['\\npagefind_version:\\s+"(?<currentValue>[^"]+)"'],
      depNameTemplate: "Pagefind/pagefind",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],

  packageRules: [
    // The exporter is pinned together with its SHA-256, which Renovate cannot compute.
    {
      matchPackageNames: ["nginx/nginx-prometheus-exporter"],
      dependencyDashboardApproval: true,
      prBodyNotes: [
        "**Also update `nginx_exporter_sha256`** from this release - otherwise the download task fails its checksum.",
      ],
    },
    // Majors are never routine. Separate PR, clearly labelled.
    {
      matchUpdateTypes: ["major"],
      labels: ["dependencies", "major - read the release notes"],
      dependencyDashboardApproval: true,
    },
  ],
}
