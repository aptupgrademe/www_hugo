---
# =============================================================================
# Sensitive values. Copy to vault.yml, fill in, encrypt:
#   ansible-vault encrypt inventory/host_vars/<host>/vault.yml
# =============================================================================

# Receives all alerts and is the Let's Encrypt account address
email: "admin@example.de"

# --- Grafana ---
# Admin login name and password, also used by the playbook for its API calls
grafana_basic_auth_user: "changeme"
grafana_admin_pass: "changeme"

# --- SMTP relay for system mails ---
mail_smtpname: "server@example.de"
mail_smtppassword: "changeme"
