---
# =============================================================================
# Host variables – test server (a copy of the production setup, no real traffic)
#
# Usage:
#   ansible-playbook blog.yml --limit test --vault-password-file .vault_pass
#
# Sensitive credentials are in vault.yml (encrypt it:
#   ansible-vault encrypt inventory/host_vars/test/vault.yml)
# =============================================================================

# --- Connection ---
# Port 22 is the default on a fresh server.
# After the first playbook run + reboot, sshd switches to 10022 – change this to 10022 then.
ansible_user: root
ansible_port: 22
ansible_host: "{{ server_ipv4 }}"

# --- Network ---
server_ipv4: "192.0.2.20"
server_ipv6: "2001:db8::20"

# --- Hostnames and URLs ---
blog_hostname: "test.example.de"
blog_url:      "https://{{ blog_hostname }}"
grafana_proxy_hostname: "{{ blog_hostname }}"

# --- Mail / SMTP ---
mail_from_address: "server"
mail_domain: "example.de"
mail_smtphost: "smtp.example.de"
mail_smtpport: 465
mail_smtpauth: "LOGIN"

# --- Static site ---
blog_web_acme_enabled: false   # DNS does not point at a test VM: self-signed certificate
blog_web_deploy_pubkey: "ssh-ed25519 AAAA... blog-deploy@builder"
