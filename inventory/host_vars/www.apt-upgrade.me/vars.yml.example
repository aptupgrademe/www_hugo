---
# =============================================================================
# Host variables – production
#
# Usage:
#   ansible-playbook blog.yml --limit www.example.de --vault-password-file .vault_pass
#
# Sensitive credentials are in vault.yml (encrypt it:
#   ansible-vault encrypt inventory/host_vars/www.example.de/vault.yml)
# =============================================================================

# --- Connection ---
# Port 22 is the default on a fresh server.
# After the first playbook run + reboot, sshd switches to 10022 – change this to 10022 then.
ansible_user: root
ansible_port: 22
ansible_host: "{{ server_ipv4 }}"

# --- Network ---
server_ipv4: "192.0.2.10"
server_ipv6: "2001:db8::10"

# --- Hostnames and URLs ---
blog_hostname: "www.example.de"
blog_url:      "https://{{ blog_hostname }}"
grafana_proxy_hostname: "{{ blog_hostname }}"

# --- Mail / SMTP ---
mail_from_address: "server"
mail_domain: "example.de"
mail_smtphost: "smtp.example.de"
mail_smtpport: 465
mail_smtpauth: "LOGIN"

# --- Static site ---
blog_web_acme_enabled: true
blog_web_deploy_pubkey: "ssh-ed25519 AAAA... blog-deploy@builder"

# --- Optional: SSH and /grafana only from these countries' IP blocks ---
fw_ssh_geo_countries: [DE]

# --- Optional: swap file size in MB, default 2048, 0 removes it ---
# sysctl_swap_mb: 2048
